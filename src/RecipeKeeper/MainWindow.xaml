<Window x:Class="RecipeKeeper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Книга рецептов"
        Width="1180"
        Height="760"
        MinWidth="1040"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#EEF2ED"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="54"
                            ResizeBorderThickness="8"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <DropShadowEffect x:Key="SoftShadow"
                          BlurRadius="22"
                          ShadowDepth="6"
                          Direction="270"
                          Color="#220F1A16"
                          Opacity="0.55" />

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#566760" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChromeButton"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChromeButton" Property="Background" Value="#E8EEE9" />
                                <Setter Property="Foreground" Value="#20352D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChromeButton" Property="Background" Value="#DCE6DF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#566760" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChromeButton"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChromeButton" Property="Background" Value="#D94F45" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChromeButton" Property="Background" Value="#B93C34" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#485951" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E8EFE9" />
                                <Setter Property="Foreground" Value="#23372F" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#DDE8DF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="164" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#1F2937" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#111827" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#0B1220" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Mouse.MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                             To="1.015"
                                             Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                             To="1.015"
                                             Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="Mouse.MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                             To="1"
                                             Duration="0:0:0.14" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                             To="1"
                                             Duration="0:0:0.14" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#52645C" />
            <Setter Property="Background" Value="#F3F7F3" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E7EEE8" />
                                <Setter Property="Foreground" Value="#20352D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategoryComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="#40524A" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EEF2FF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E5EFE8" />
                                <Setter Property="Foreground" Value="#2563EB" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategoryComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#40524A" />
            <Setter Property="Background" Value="#F3F6F4" />
            <Setter Property="BorderBrush" Value="#E5ECE7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource CategoryComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboSurface"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      VerticalAlignment="Center"
                                                      RecognizesAccessKey="True" />
                                    <Path Grid.Column="1"
                                          Data="M 3 6 L 9 12 L 15 6"
                                          Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <ToggleButton Focusable="False"
                                          Opacity="0"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,6,0,0"
                                        Background="White"
                                        BorderBrush="#E2EAE4"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="5"
                                        Effect="{StaticResource SoftShadow}">
                                    <ScrollViewer CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboSurface" Property="Background" Value="#ECF2EE" />
                                <Setter TargetName="ComboSurface" Property="BorderBrush" Value="#D4E1D8" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboSurface" Property="Background" Value="#EDEFF5" />
                                <Setter TargetName="ComboSurface" Property="BorderBrush" Value="#B8D0C2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RecipeCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Effect" Value="{StaticResource SoftShadow}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Mouse.MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                             To="-2"
                                             Duration="0:0:0.14" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="Mouse.MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                             To="0"
                                             Duration="0:0:0.16" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Shell"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0"
                                     To="1"
                                     Duration="0:0:0.24" />
                    <DoubleAnimation Storyboard.TargetName="ShellTranslate"
                                     Storyboard.TargetProperty="Y"
                                     From="12"
                                     To="0"
                                     Duration="0:0:0.24">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="RootFrame"
            Background="#F7F8F4"
            BorderBrush="#DDE6DF"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar"
                  Grid.Row="0"
                  Background="#FBFCF8"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            Margin="22,0,0,0"
                            VerticalAlignment="Center">
                    <Border Width="30"
                            Height="30"
                            CornerRadius="8"
                            Background="#111827">
                        <TextBlock Text="К"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Книга рецептов"
                               Foreground="#20352D"
                               FontSize="15"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="ThemeToggleButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Content="☾"
                            ToolTip="Переключить тему"
                            Click="ThemeToggleButton_Click" />
                    <Button Style="{StaticResource TitleBarButtonStyle}"
                            Content="−"
                            Click="MinimizeButton_Click" />
                    <Button Style="{StaticResource TitleBarButtonStyle}"
                            Content="□"
                            Click="MaximizeButton_Click" />
                    <Button Style="{StaticResource CloseButtonStyle}"
                            Content="×"
                            Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <Grid x:Name="MainArea"
                  Grid.Row="1">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F7F8F4" Offset="0" />
                        <GradientStop Color="#F1F3F6" Offset="0.56" />
                        <GradientStop Color="#FBF3EA" Offset="1" />
                    </LinearGradientBrush>
                </Grid.Background>

                <Grid x:Name="Shell"
                      Margin="24"
                      Opacity="0">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="ShellTranslate" />
                    </Grid.RenderTransform>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="238" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#FFFFFF"
                            CornerRadius="8"
                            Padding="20"
                            Effect="{StaticResource SoftShadow}">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Top">
                                <Grid Margin="0,0,0,28">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="44"
                                            Height="44"
                                            CornerRadius="8"
                                            Background="#111827">
                                        <TextBlock Text="К"
                                                   Foreground="White"
                                                   FontSize="21"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Книга рецептов"
                                                   Foreground="#1F2F2A"
                                                   FontSize="17"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Домашняя коллекция"
                                                   Foreground="#77847E"
                                                   FontSize="12" />
                                    </StackPanel>
                                </Grid>

                                <Button Style="{StaticResource NavButtonStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="24" Height="24" CornerRadius="7" Background="#EAF0FF">
                                            <TextBlock Text="⌂" Foreground="#2563EB" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Все рецепты" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource NavButtonStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="24" Height="24" CornerRadius="7" Background="#F7EFE4">
                                            <TextBlock Text="★" Foreground="#9A6B2C" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Избранное" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource NavButtonStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="24" Height="24" CornerRadius="7" Background="#F0EDF8">
                                            <TextBlock Text="≡" Foreground="#6A5191" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Категории" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource NavButtonStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="24" Height="24" CornerRadius="7" Background="#EBF2F8">
                                            <TextBlock Text="✓" Foreground="#3E6680" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Покупки" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </StackPanel>

                            <Border DockPanel.Dock="Bottom"
                                    Background="#F2F4F7"
                                    CornerRadius="8"
                                    Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Коллекция"
                                               Foreground="#728079"
                                               FontSize="12" />
                                    <TextBlock Text="12 рецептов"
                                               Foreground="#1F2F2A"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="4 любимых блюда"
                                               Foreground="#6A7771"
                                               FontSize="12"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Мои рецепты"
                                           Foreground="#1F2F2A"
                                           FontSize="32"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Сохраняйте блюда, заметки, ингредиенты и идеи в одном месте."
                                           Foreground="#66756E"
                                           FontSize="15"
                                           Margin="0,6,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Content="⌕"
                                        Margin="0,0,10,0"
                                        ToolTip="Перейти к поиску"
                                        Click="SearchButton_Click" />
                                <Button Style="{StaticResource PrimaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <Border Width="18"
                                                Height="18"
                                                CornerRadius="6"
                                                Background="#2563EB"
                                                Margin="0,0,9,0">
                                            <Grid>
                                                <Rectangle Width="10"
                                                           Height="2"
                                                           RadiusX="1"
                                                           RadiusY="1"
                                                           Fill="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                <Rectangle Width="2"
                                                           Height="10"
                                                           RadiusX="1"
                                                           RadiusY="1"
                                                           Fill="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="Новый рецепт"
                                                   VerticalAlignment="Center"
                                                   LineHeight="18" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="330" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Background="White"
                                        CornerRadius="8"
                                        Padding="14"
                                        Effect="{StaticResource SoftShadow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="162" />
                                        </Grid.ColumnDefinitions>

                                        <Border Height="42"
                                                Background="#F3F6F4"
                                                CornerRadius="8"
                                                Padding="13,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="⌕"
                                                           Foreground="#66776F"
                                                           FontSize="17"
                                                           VerticalAlignment="Center" />
                                                <Grid Grid.Column="1">
                                                    <TextBox x:Name="SearchTextBox"
                                                             Foreground="#111827"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             FontSize="14"
                                                             VerticalContentAlignment="Center" />
                                                    <TextBlock Text="Поиск по названию или ингредиенту"
                                                               Foreground="#6C7B74"
                                                               FontSize="14"
                                                               IsHitTestVisible="False"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <ComboBox Grid.Column="2"
                                                  Style="{StaticResource CategoryComboBoxStyle}"
                                                  SelectedIndex="0"
                                                  VerticalAlignment="Center">
                                            <ComboBoxItem Content="Все категории" />
                                            <ComboBoxItem Content="Завтраки" />
                                            <ComboBoxItem Content="Ужины" />
                                            <ComboBoxItem Content="Выпечка" />
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <ScrollViewer Grid.Row="2"
                                              VerticalScrollBarVisibility="Auto"
                                              Padding="0,0,10,0">
                                    <StackPanel>
                                        <Border Style="{StaticResource RecipeCardStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="74" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="58" Height="58" CornerRadius="8" Background="#F3D8C6">
                                                    <Grid>
                                                        <Ellipse Width="34" Height="34" Fill="#E65F3C" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Ellipse Width="14" Height="14" Fill="#F8E7B4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,13,0" />
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Паста с томатами и базиликом"
                                                               Foreground="#1F2F2A"
                                                               FontSize="16"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="25 минут · ужин · 7 ингредиентов"
                                                               Foreground="#728079"
                                                               FontSize="13"
                                                               Margin="0,5,0,0" />
                                                </StackPanel>

                                                <Border Grid.Column="2"
                                                        Background="#EDF4EE"
                                                        CornerRadius="8"
                                                        Padding="12,7"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="Италия"
                                                               Foreground="#2F6F57"
                                                               FontSize="12"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource RecipeCardStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="74" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="58" Height="58" CornerRadius="8" Background="#DCEADE">
                                                    <Grid>
                                                        <Ellipse Width="40" Height="28" Fill="#4E9B6E" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Rectangle Width="24" Height="8" Fill="#FFE8B7" RadiusX="4" RadiusY="4" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,11" />
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Куриный суп с зеленью"
                                                               Foreground="#1F2F2A"
                                                               FontSize="16"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="55 минут · обед · семейный рецепт"
                                                               Foreground="#728079"
                                                               FontSize="13"
                                                               Margin="0,5,0,0" />
                                                </StackPanel>

                                                <Border Grid.Column="2"
                                                        Background="#F4EEE5"
                                                        CornerRadius="8"
                                                        Padding="12,7"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="Домашнее"
                                                               Foreground="#9A5A2B"
                                                               FontSize="12"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource RecipeCardStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="74" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="58" Height="58" CornerRadius="8" Background="#E8E3F4">
                                                    <Grid>
                                                        <Ellipse Width="40" Height="40" Fill="#7955A6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Ellipse Width="11" Height="11" Fill="#F6F3FB" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,14,0,0" />
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Черничный чизкейк"
                                                               Foreground="#1F2F2A"
                                                               FontSize="16"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="1 час 20 минут · десерт · заметки из интернета"
                                                               Foreground="#728079"
                                                               FontSize="13"
                                                               Margin="0,5,0,0" />
                                                </StackPanel>

                                                <Border Grid.Column="2"
                                                        Background="#F0ECF7"
                                                        CornerRadius="8"
                                                        Padding="12,7"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="Выпечка"
                                                               Foreground="#6B4C9A"
                                                               FontSize="12"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <StackPanel Grid.Column="2">
                                <Border Background="#111827"
                                        CornerRadius="8"
                                        Padding="22"
                                        Effect="{StaticResource SoftShadow}">
                                    <Grid Height="228">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Canvas HorizontalAlignment="Center"
                                                VerticalAlignment="Top"
                                                Width="246"
                                                Height="150">
                                            <Ellipse Width="148" Height="148" Canvas.Left="49" Canvas.Top="0" Fill="#334155" />
                                            <Rectangle Width="116" Height="80" Canvas.Left="65" Canvas.Top="40" RadiusX="8" RadiusY="8" Fill="#FFF7E8" />
                                            <Rectangle Width="82" Height="10" Canvas.Left="82" Canvas.Top="60" RadiusX="5" RadiusY="5" Fill="#D8B47B" />
                                            <Rectangle Width="70" Height="8" Canvas.Left="82" Canvas.Top="80" RadiusX="4" RadiusY="4" Fill="#8AA5D8" />
                                            <Rectangle Width="52" Height="8" Canvas.Left="82" Canvas.Top="99" RadiusX="4" RadiusY="4" Fill="#DD8061" />
                                            <Path Data="M34,128 C48,104 82,94 110,112 C132,126 158,126 181,110 C197,100 216,105 226,126 L226,140 L34,140 Z" Fill="#E7B768" />
                                            <Ellipse Width="34" Height="18" Canvas.Left="174" Canvas.Top="96" Fill="#F7E2A1" />
                                            <Path Data="M189,97 C187,83 195,73 207,65" Stroke="#9CB7EA" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            <Path Data="M202,69 C216,63 228,69 231,82" Stroke="#9CB7EA" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Canvas>

                                        <StackPanel Grid.Row="1">
                                            <TextBlock Text="Идея дня"
                                                       Foreground="#C9D8CF"
                                                       FontSize="13" />
                                            <TextBlock Text="Добавьте рецепт, который давно лежит в закладках."
                                                       Foreground="White"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Background="White"
                                        CornerRadius="8"
                                        Padding="18"
                                        Margin="0,16,0,0"
                                        Effect="{StaticResource SoftShadow}">
                                    <StackPanel>
                                        <TextBlock Text="Быстрые категории"
                                                   Foreground="#1F2F2A"
                                                   FontSize="17"
                                                   FontWeight="SemiBold" />

                                        <UniformGrid Columns="2" Margin="0,14,0,0">
                                            <Border Background="#F3F6F4" CornerRadius="8" Padding="12" Margin="0,0,7,7">
                                                <TextBlock Text="Завтраки" Foreground="#40524A" FontWeight="SemiBold" />
                                            </Border>
                                            <Border Background="#F7F1EA" CornerRadius="8" Padding="12" Margin="7,0,0,7">
                                                <TextBlock Text="Ужины" Foreground="#7A5836" FontWeight="SemiBold" />
                                            </Border>
                                            <Border Background="#F2EEF7" CornerRadius="8" Padding="12" Margin="0,7,7,0">
                                                <TextBlock Text="Десерты" Foreground="#684C8F" FontWeight="SemiBold" />
                                            </Border>
                                            <Border Background="#EEF3F8" CornerRadius="8" Padding="12" Margin="7,7,0,0">
                                                <TextBlock Text="Напитки" Foreground="#365B73" FontWeight="SemiBold" />
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
