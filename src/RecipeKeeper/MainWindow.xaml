<Window x:Class="RecipeKeeper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Книга рецептов"
        Width="1180"
        Height="760"
        MinWidth="1040"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="54"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F7F8F4" />
        <SolidColorBrush x:Key="TopBarBrush" Color="#FBFCF8" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="InputBrush" Color="#F3F6F4" />
        <SolidColorBrush x:Key="TextBrush" Color="#111827" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#66756E" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#DDE6DF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#1F2937" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#111827" />
        <SolidColorBrush x:Key="IconSurfaceBrush" Color="#F3F7F3" />
        <SolidColorBrush x:Key="PromoBrush" Color="#111827" />
        <SolidColorBrush x:Key="BlueAccentBrush" Color="#2563EB" />

        <DropShadowEffect x:Key="SoftShadow"
                          BlurRadius="22"
                          ShadowDepth="6"
                          Direction="270"
                          Color="#220F1A16"
                          Opacity="0.55" />

        <Style x:Key="ChromeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChromeButton"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChromeButton" Property="Background" Value="{DynamicResource InputBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource ChromeButtonStyle}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChromeButton"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChromeButton" Property="Background" Value="#D94F45" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChromeButton" Property="Background" Value="#B93C34" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource InputBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="116" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource IconSurfaceBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource IconSurfaceBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource InputBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource BlueAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="Background" Value="{DynamicResource IconSurfaceBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource InputBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource BlueAccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboSurface"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      VerticalAlignment="Center" />
                                    <Path Grid.Column="1"
                                          Data="M 3 6 L 9 12 L 15 6"
                                          Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ToggleButton Focusable="False"
                                          Opacity="0"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Popup Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,6,0,0"
                                        Background="{DynamicResource CardBrush}"
                                        BorderBrush="{DynamicResource BorderBrushSoft}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="5"
                                        Effect="{StaticResource SoftShadow}">
                                    <ScrollViewer CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboSurface" Property="Background" Value="{DynamicResource IconSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboSurface" Property="BorderBrush" Value="{DynamicResource BlueAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="CheckBoxMark"
                                    Width="20"
                                    Height="20"
                                    CornerRadius="6"
                                    Background="{DynamicResource InputBrush}"
                                    BorderBrush="{DynamicResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    Margin="0,0,9,0">
                                <TextBlock x:Name="CheckGlyph"
                                           Text="✓"
                                           Foreground="White"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxMark" Property="Background" Value="{DynamicResource BlueAccentBrush}" />
                                <Setter TargetName="CheckBoxMark" Property="BorderBrush" Value="{DynamicResource BlueAccentBrush}" />
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource BorderBrushSoft}"
                                CornerRadius="4" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Opacity="0"
                                                  IsTabStop="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="36" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Opacity="0"
                                                  IsTabStop="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="8" />
                    <Setter Property="Width" Value="Auto" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RecipeCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Effect" Value="{StaticResource SoftShadow}" />
        </Style>
    </Window.Resources>

    <Border x:Name="RootFrame"
            Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrushSoft}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar"
                  Grid.Row="0"
                  Background="{DynamicResource TopBarBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="22,0,0,0" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="К" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="TitleBarAppNameText"
                               Text="Книга рецептов"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="LanguageToggleButton" Style="{StaticResource ChromeButtonStyle}" Content="EN" ToolTip="Switch to English" AutomationProperties.Name="Переключить язык" Click="LanguageToggleButton_Click" />
                    <Button x:Name="ThemeToggleButton" Style="{StaticResource ChromeButtonStyle}" Content="☾" ToolTip="Включить темную тему" AutomationProperties.Name="Переключить тему" Click="ThemeToggleButton_Click" />
                    <Button Style="{StaticResource ChromeButtonStyle}" Content="−" Click="MinimizeButton_Click" />
                    <Button Style="{StaticResource CloseButtonStyle}" Content="×" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="276" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource PanelBrush}"
                        CornerRadius="8"
                        Padding="20"
                        Margin="24,24,0,24"
                        Effect="{StaticResource SoftShadow}">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top">
                            <Grid Margin="0,0,0,26">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="8" Background="{DynamicResource AccentBrush}">
                                    <TextBlock Text="К" Foreground="White" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="SidebarTitleText" Text="Книга рецептов" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock x:Name="SidebarSubtitleText" Text="Коллекция рецептов" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                                </StackPanel>
                            </Grid>

                            <Button x:Name="AllRecipesButton" Style="{StaticResource NavButtonStyle}" Click="ShowAllRecipes_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource IconSurfaceBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="⌂" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Name="AllRecipesNavText" Grid.Column="1" Text="Все рецепты" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button x:Name="FavoritesButton" Style="{StaticResource NavButtonStyle}" Click="ShowFavorites_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource IconSurfaceBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="★" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Name="FavoritesNavText" Grid.Column="1" Text="Избранное" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button x:Name="CategoriesButton" Style="{StaticResource NavButtonStyle}" Click="ShowCategories_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource IconSurfaceBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="≡" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Name="CategoriesNavText" Grid.Column="1" Text="Категории" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <Border DockPanel.Dock="Bottom" Background="{DynamicResource InputBrush}" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <TextBlock x:Name="CollectionLabelText" Text="Коллекция" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                                <TextBlock x:Name="RecipeCountText" Text="0 рецептов" Foreground="{DynamicResource TextBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                                <TextBlock x:Name="FavoriteCountText" Text="0 любимых блюд" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="2" Margin="0,24,24,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderTitle" Text="Мои рецепты" Foreground="{DynamicResource TextBrush}" FontSize="32" FontWeight="SemiBold" />
                            <TextBlock x:Name="HeaderSubtitle" Text="Сохраняйте блюда, ингредиенты и пошаговые заметки в одном месте." Foreground="{DynamicResource MutedTextBrush}" FontSize="15" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="SearchShortcutButton" Style="{StaticResource IconButtonStyle}" Content="⌕" Margin="0,0,10,0" ToolTip="Перейти к поиску" AutomationProperties.Name="Поиск" Click="SearchButton_Click" />
                            <Button x:Name="NewRecipeButton" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.Name="Новый рецепт" Click="NewRecipeButton_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="+" FontSize="18" FontWeight="SemiBold" Margin="0,-1,8,0" />
                                    <TextBlock x:Name="NewRecipeButtonText" Text="Новый рецепт" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="330" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="14" Effect="{StaticResource SoftShadow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="180" />
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <TextBox x:Name="SearchTextBox"
                                                 Style="{StaticResource InputTextBoxStyle}"
                                                 TextChanged="SearchTextBox_TextChanged"
                                                 ToolTip="Поиск по названию, категории, ингредиентам и шагам" />
                                        <TextBlock x:Name="SearchPlaceholderText"
                                                   Text="Поиск по названию или ингредиенту"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="14"
                                                   Margin="13,0,0,0"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Text, ElementName=SearchTextBox}" Value="" />
                                                                <Condition Binding="{Binding IsKeyboardFocused, ElementName=SearchTextBox}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <ComboBox x:Name="CategoryFilterComboBox"
                                              Grid.Column="2"
                                              Style="{StaticResource InputComboBoxStyle}"
                                              SelectionChanged="CategoryFilterComboBox_SelectionChanged" />
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                                <StackPanel x:Name="RecipeListPanel" />
                            </ScrollViewer>
                        </Grid>

                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="RightPanel" />
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>

            <Grid x:Name="EditorOverlay"
                  Grid.RowSpan="2"
                  Background="#99000000"
                  Visibility="Collapsed">
                <Border Width="720"
                        MaxHeight="690"
                        Background="{DynamicResource PanelBrush}"
                        CornerRadius="8"
                        Padding="24,24,14,24"
                        Effect="{StaticResource SoftShadow}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Padding="0,0,6,0">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock x:Name="EditorTitleText" Text="Новый рецепт" Foreground="{DynamicResource TextBrush}" FontSize="26" FontWeight="SemiBold" />
                            <TextBlock x:Name="EditorSubtitleText" Text="Добавьте название, категорию, ингредиенты и пошаговый процесс." Foreground="{DynamicResource MutedTextBrush}" FontSize="14" Margin="0,6,0,18" />

                            <TextBlock x:Name="RecipeTitleLabelText" Text="Название" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
                            <TextBox x:Name="RecipeTitleTextBox" Style="{StaticResource InputTextBoxStyle}" Margin="0,6,0,14" />

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="RecipeCategoryLabelText" Text="Категория" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
                                    <ComboBox x:Name="RecipeCategoryComboBox"
                                              Style="{StaticResource InputComboBoxStyle}"
                                              Margin="0,6,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="NewCategoryLabelText" Text="Новая категория" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
                                    <TextBox x:Name="NewCategoryTextBox"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             Margin="0,6,0,0"
                                             ToolTip="Заполните, если нужной категории нет в списке" />
                                </StackPanel>
                            </Grid>

                            <CheckBox x:Name="FavoriteRecipeCheckBox"
                                      Content="Добавить в избранное"
                                      Style="{StaticResource ModernCheckBoxStyle}"
                                      Margin="0,0,0,18" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="IngredientsLabelText" Text="Ингредиенты" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button x:Name="AddIngredientButton" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="+ ингредиент" Click="AddIngredientButton_Click" />
                            </Grid>
                            <StackPanel x:Name="IngredientsPanel" Margin="0,0,0,18" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="StepsLabelText" Text="Шаги приготовления" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button x:Name="AddStepButton" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="+ шаг" Click="AddStepButton_Click" />
                            </Grid>
                            <StackPanel x:Name="StepsPanel" Margin="0,0,0,22" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="CancelEditorButton" Style="{StaticResource SecondaryButtonStyle}" Content="Отмена" Margin="0,0,10,0" Click="CancelEditorButton_Click" />
                                <Button x:Name="SaveRecipeButton" Style="{StaticResource PrimaryButtonStyle}" Content="Сохранить рецепт" Click="SaveRecipeButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Grid x:Name="DialogOverlay"
                  Grid.RowSpan="2"
                  Background="#99000000"
                  Visibility="Collapsed">
                <Border Width="430"
                        Background="{DynamicResource PanelBrush}"
                        CornerRadius="8"
                        Padding="22"
                        Effect="{StaticResource SoftShadow}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="DialogIconBadge"
                                    Width="38"
                                    Height="38"
                                    CornerRadius="8"
                                    Background="{DynamicResource InputBrush}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top">
                                <TextBlock x:Name="DialogIconText"
                                           Text="!"
                                           Foreground="{DynamicResource BlueAccentBrush}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="DialogTitleText"
                                           Text="Предупреждение"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="DialogMessageText"
                                           Text="Сообщение"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="14"
                                           LineHeight="20"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="DialogSecondaryButton"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Нет"
                                    Margin="0,0,10,0"
                                    Click="DialogSecondaryButton_Click" />
                            <Button x:Name="DialogPrimaryButton"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="Да"
                                    Click="DialogPrimaryButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
