<Window x:Class="RecipeKeeper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="RecipeKeeper"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F6F7F4"
        FontFamily="Segoe UI">
    <Window.Resources>
        <DropShadowEffect x:Key="SoftShadow"
                          BlurRadius="24"
                          ShadowDepth="8"
                          Direction="270"
                          Color="#13000000"
                          Opacity="0.72" />

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#40524A" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E8EFE7" />
                                <Setter Property="Foreground" Value="#213A30" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#DDE8DB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2F6F57" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#255E49" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1E4D3D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Mouse.MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                             To="1.02"
                                             Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                             To="1.02"
                                             Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="Mouse.MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                             To="1"
                                             Duration="0:0:0.14" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                             To="1"
                                             Duration="0:0:0.14" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RecipeCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Effect" Value="{StaticResource SoftShadow}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Mouse.MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                             To="1.01"
                                             Duration="0:0:0.14" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                             To="1.01"
                                             Duration="0:0:0.14" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="Mouse.MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                             To="1"
                                             Duration="0:0:0.16" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                             To="1"
                                             Duration="0:0:0.16" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Shell"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0"
                                     To="1"
                                     Duration="0:0:0.28" />
                    <DoubleAnimation Storyboard.TargetName="ShellTranslate"
                                     Storyboard.TargetProperty="Y"
                                     From="18"
                                     To="0"
                                     Duration="0:0:0.28">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F7F8F4" Offset="0" />
                <GradientStop Color="#EEF4F1" Offset="0.52" />
                <GradientStop Color="#F9F3ED" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid x:Name="Shell"
              Margin="28"
              Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ShellTranslate" />
            </Grid.RenderTransform>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#FDFDFB"
                    CornerRadius="8"
                    Padding="22"
                    Effect="{StaticResource SoftShadow}">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <Grid Margin="0,0,0,32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Width="42"
                                    Height="42"
                                    CornerRadius="8"
                                    Background="#2F6F57">
                                <TextBlock Text="R"
                                           Foreground="White"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="RecipeKeeper"
                                           Foreground="#1F2F2A"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Домашняя книга"
                                           Foreground="#77847E"
                                           FontSize="12" />
                            </StackPanel>
                        </Grid>

                        <Button Style="{StaticResource NavButtonStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="⌂" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Все рецепты" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="★" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Избранное" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="≡" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Категории" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="□" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Список покупок" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom"
                            Background="#EEF4F1"
                            CornerRadius="8"
                            Padding="14">
                        <StackPanel>
                            <TextBlock Text="Сегодня"
                                       Foreground="#728079"
                                       FontSize="12" />
                            <TextBlock Text="12 рецептов"
                                       Foreground="#1F2F2A"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="4 любимых блюда"
                                       Foreground="#6A7771"
                                       FontSize="12"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Мои рецепты"
                                   Foreground="#1F2F2A"
                                   FontSize="34"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Сохраняйте блюда, заметки, ингредиенты и идеи в одном месте."
                                   Foreground="#66756E"
                                   FontSize="15"
                                   Margin="0,6,0,0" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource PrimaryButtonStyle}"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Margin="0,-1,8,0" />
                            <TextBlock Text="Новый рецепт" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="White"
                                CornerRadius="8"
                                Padding="16"
                                Effect="{StaticResource SoftShadow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>

                                <Border Height="44"
                                        Background="#F3F6F4"
                                        CornerRadius="8"
                                        Padding="14,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="⌕"
                                                   Foreground="#6C7B74"
                                                   FontSize="18"
                                                   VerticalAlignment="Center" />
                                        <Grid Grid.Column="1">
                                            <TextBox x:Name="SearchTextBox"
                                                     Foreground="#243A31"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     FontSize="14"
                                                     VerticalContentAlignment="Center" />
                                            <TextBlock Text="Поиск по названию или ингредиенту"
                                                       Foreground="#6C7B74"
                                                       FontSize="14"
                                                       IsHitTestVisible="False"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <ComboBox Grid.Column="2"
                                          Height="44"
                                          SelectedIndex="0"
                                          Padding="12,0"
                                          FontSize="14"
                                          Foreground="#42524B">
                                    <ComboBoxItem Content="Все категории" />
                                    <ComboBoxItem Content="Завтраки" />
                                    <ComboBoxItem Content="Ужины" />
                                    <ComboBoxItem Content="Выпечка" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="0,0,10,0">
                            <StackPanel>
                                <Border Style="{StaticResource RecipeCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="78" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="64"
                                                Height="64"
                                                CornerRadius="8"
                                                Background="#F3D8C6">
                                            <Grid>
                                                <Ellipse Width="36"
                                                         Height="36"
                                                         Fill="#E65F3C"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center" />
                                                <Ellipse Width="16"
                                                         Height="16"
                                                         Fill="#F8E7B4"
                                                         HorizontalAlignment="Right"
                                                         VerticalAlignment="Top"
                                                         Margin="0,12,14,0" />
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Паста с томатами и базиликом"
                                                       Foreground="#1F2F2A"
                                                       FontSize="17"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="25 минут • ужин • 7 ингредиентов"
                                                       Foreground="#728079"
                                                       FontSize="13"
                                                       Margin="0,5,0,0" />
                                        </StackPanel>

                                        <Border Grid.Column="2"
                                                Background="#EDF4EE"
                                                CornerRadius="8"
                                                Padding="12,7"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="Италия"
                                                       Foreground="#2F6F57"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource RecipeCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="78" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="64"
                                                Height="64"
                                                CornerRadius="8"
                                                Background="#DCEADE">
                                            <Grid>
                                                <Ellipse Width="42"
                                                         Height="30"
                                                         Fill="#4E9B6E"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center" />
                                                <Rectangle Width="26"
                                                           Height="8"
                                                           Fill="#FFE8B7"
                                                           RadiusX="4"
                                                           RadiusY="4"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Bottom"
                                                           Margin="0,0,0,12" />
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Куриный суп с зеленью"
                                                       Foreground="#1F2F2A"
                                                       FontSize="17"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="55 минут • обед • семейный рецепт"
                                                       Foreground="#728079"
                                                       FontSize="13"
                                                       Margin="0,5,0,0" />
                                        </StackPanel>

                                        <Border Grid.Column="2"
                                                Background="#F4EEE5"
                                                CornerRadius="8"
                                                Padding="12,7"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="Домашнее"
                                                       Foreground="#9A5A2B"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource RecipeCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="78" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="64"
                                                Height="64"
                                                CornerRadius="8"
                                                Background="#E8E3F4">
                                            <Grid>
                                                <Ellipse Width="42"
                                                         Height="42"
                                                         Fill="#7955A6"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center" />
                                                <Ellipse Width="12"
                                                         Height="12"
                                                         Fill="#F6F3FB"
                                                         HorizontalAlignment="Left"
                                                         VerticalAlignment="Top"
                                                         Margin="15,15,0,0" />
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Черничный чизкейк"
                                                       Foreground="#1F2F2A"
                                                       FontSize="17"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="1 час 20 минут • десерт • заметки из интернета"
                                                       Foreground="#728079"
                                                       FontSize="13"
                                                       Margin="0,5,0,0" />
                                        </StackPanel>

                                        <Border Grid.Column="2"
                                                Background="#F0ECF7"
                                                CornerRadius="8"
                                                Padding="12,7"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="Выпечка"
                                                       Foreground="#6B4C9A"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <StackPanel Grid.Column="2">
                        <Border Background="#243A31"
                                CornerRadius="8"
                                Padding="24"
                                Effect="{StaticResource SoftShadow}">
                            <Grid Height="230">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Canvas HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        Width="250"
                                        Height="155">
                                    <Ellipse Width="154"
                                             Height="154"
                                             Canvas.Left="48"
                                             Canvas.Top="0"
                                             Fill="#335446" />
                                    <Rectangle Width="118"
                                               Height="82"
                                               Canvas.Left="66"
                                               Canvas.Top="42"
                                               RadiusX="8"
                                               RadiusY="8"
                                               Fill="#FFF7E8" />
                                    <Rectangle Width="86"
                                               Height="10"
                                               Canvas.Left="82"
                                               Canvas.Top="62"
                                               RadiusX="5"
                                               RadiusY="5"
                                               Fill="#D8B47B" />
                                    <Rectangle Width="72"
                                               Height="8"
                                               Canvas.Left="82"
                                               Canvas.Top="82"
                                               RadiusX="4"
                                               RadiusY="4"
                                               Fill="#8FB59B" />
                                    <Rectangle Width="54"
                                               Height="8"
                                               Canvas.Left="82"
                                               Canvas.Top="101"
                                               RadiusX="4"
                                               RadiusY="4"
                                               Fill="#DD8061" />
                                    <Path Data="M34,132 C48,104 82,94 110,114 C132,130 158,128 181,112 C197,101 216,106 226,128 L226,142 L34,142 Z"
                                          Fill="#E7B768" />
                                    <Ellipse Width="34"
                                             Height="18"
                                             Canvas.Left="176"
                                             Canvas.Top="98"
                                             Fill="#F7E2A1" />
                                    <Path Data="M191,99 C188,83 195,73 207,65"
                                          Stroke="#A8D3B4"
                                          StrokeThickness="5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                    <Path Data="M202,69 C218,63 229,69 232,82"
                                          Stroke="#A8D3B4"
                                          StrokeThickness="5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                </Canvas>

                                <StackPanel Grid.Row="1">
                                    <TextBlock Text="Идея дня"
                                               Foreground="#C9D8CF"
                                               FontSize="13" />
                                    <TextBlock Text="Добавьте рецепт, который давно лежит в закладках."
                                               Foreground="White"
                                               FontSize="21"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="White"
                                CornerRadius="8"
                                Padding="20"
                                Margin="0,18,0,0"
                                Effect="{StaticResource SoftShadow}">
                            <StackPanel>
                                <TextBlock Text="Быстрые категории"
                                           Foreground="#1F2F2A"
                                           FontSize="17"
                                           FontWeight="SemiBold" />

                                <UniformGrid Columns="2"
                                             Margin="0,16,0,0">
                                    <Border Background="#F3F6F4" CornerRadius="8" Padding="12" Margin="0,0,8,8">
                                        <TextBlock Text="Завтраки" Foreground="#40524A" FontWeight="SemiBold" />
                                    </Border>
                                    <Border Background="#F7F1EA" CornerRadius="8" Padding="12" Margin="8,0,0,8">
                                        <TextBlock Text="Ужины" Foreground="#7A5836" FontWeight="SemiBold" />
                                    </Border>
                                    <Border Background="#F2EEF7" CornerRadius="8" Padding="12" Margin="0,8,8,0">
                                        <TextBlock Text="Десерты" Foreground="#684C8F" FontWeight="SemiBold" />
                                    </Border>
                                    <Border Background="#EEF3F8" CornerRadius="8" Padding="12" Margin="8,8,0,0">
                                        <TextBlock Text="Напитки" Foreground="#365B73" FontWeight="SemiBold" />
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
